# Groq — para transcripción con Whisper
GROQ_API_KEY=

# Monad Testnet — wallet con MON de testnet para pagar gas
MONAD_PRIVATE_KEY=0x...

# Dirección del contrato desplegado en Monad Testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Modo demo: si es "true" omite Whisper y usa transcripción simulada
DEMO_MODE=false

# WhatsApp: vincula primero el número emisor con npm run whatsapp:login.
# Después vincula el número del tutor desde la página web. Las credenciales
# se guardan en .baileys_sender_auth/ y .baileys_auth/, respectivamente.
