# Groq — para transcripción con Whisper
GROQ_API_KEY=

# Monad Testnet — wallet con MON de testnet para pagar gas
MONAD_PRIVATE_KEY=0x...

# Dirección del contrato desplegado en Monad Testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Modo demo: si es "true" omite Whisper y usa transcripción simulada
DEMO_MODE=false

# WhatsApp (Baileys) — número del tutor que recibirá las alertas,
# en formato E.164 sin "+" (ej. 521234567890)
# No hace falta token: corre "npm run whatsapp:login" una vez y escanea el QR
# con el WhatsApp que enviará las alertas. La sesión se guarda en .baileys_auth/
TUTOR_WHATSAPP_NUMBER=521234567890
